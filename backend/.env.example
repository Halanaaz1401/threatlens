# ThreatLens Enterprise Backend Configuration Template (Phase 2)
# DO NOT commit real secrets or production credentials to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Core Security / JWT
SECRET_KEY=change_this_to_a_strong_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primary PostgreSQL 16 Persistence
POSTGRES_USER=threatlens_admin
POSTGRES_PASSWORD=threatlens_secure_password_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatlens_db
# In container / prod, set DATABASE_URL or let it construct from above:
# DATABASE_URL=postgresql://threatlens_admin:threatlens_secure_password_2026@localhost:5432/threatlens_db
# For offline local development, you may set:
# DATABASE_URL=sqlite:///./threatlens.db

# Redis Infrastructure (Token Revocation & Caching)
REDIS_URL=redis://localhost:6379/0

# Elasticsearch 8.x Infrastructure (Threat Indicator Search & Analytics)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=threatlens_indicators

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://threatlens.ashlynxcyber.in

# Threat Feeds & External Intelligence APIs (Optional)
# OTX_API_KEY=
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
