# ThreatLens Backend Environment Configuration Template
# DO NOT commit production secrets to version control.

# Core Security / JWT
SECRET_KEY=change_this_to_a_strong_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatlens

# CORS Whitelist (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://threatlens.ashlynxcyber.in

# Threat Feeds & External APIs (Optional API keys loaded dynamically)
# OTX_API_KEY=
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
